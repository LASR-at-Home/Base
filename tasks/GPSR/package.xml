<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>GPSR</name>
  <version>0.0.0</version>
  <description>GPSR autonomous behaviour task</description>
  <maintainer email="michelebrienza1997@gmail.com">Michele Brienza</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>skills</depend>
  <depend>simulation</depend>
  <depend>lasr_speech_recognition_interfaces</depend>
  <depend>lasr_speech_recognition_whisper</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <build_depend>ament_virtualenv</build_depend>
  <export>
    <build_type>ament_python</build_type>
    <pip_requirements>requirements.txt</pip_requirements>
  </export>
</package>
