<package format="3">
  <name>restaurant</name>
  <version>0.0.0</version>
  <description>Restaurant task</description>
  <maintainer email="illiaputintsev03@gmail.com">illia</maintainer>
  <license>MIT</license>

  <depend>smach</depend>
  <depend>smach_ros</depend>
  <depend>skills</depend>
  <depend>lasr_vision_interfaces</depend>
  <depend>std_msgs</depend>
