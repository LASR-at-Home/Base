<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>lasr_vision_open_vocabulary</name>
    <version>0.0.0</version>
    <description>Open-vocabulary object detection and segmentation service</description>
    <maintainer email="michelebrienza1997@gmail.com">Michele Brienza</maintainer>
    <license>MIT</license>

    <depend>lasr_vision_interfaces</depend>
    <depend>sensor_msgs</depend>
    <depend>cv_bridge</depend>

    <build_depend>ament_virtualenv</build_depend>

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
        <pip_requirements>requirements.txt</pip_requirements>
    </export>
</package>
